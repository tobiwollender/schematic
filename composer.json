{
    "name": "tobiwollender/schematic",
    "description": "Editor-friendly schema.org structured data for TYPO3, built on brotkrueml/schema",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "authors": [
        {
            "name": "Tobi Wollender",
            "homepage": "https://www.wollender.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "brotkrueml/schema": "^4.4",
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "autoload": {
        "psr-4": {
            "TobiWollender\\Schematic\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "schematic"
        }
    }
}
